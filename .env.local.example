# Local Development Configuration
# Copy this to .env for local development with SQLite

# Database Type (sqlite or postgres)
DB_TYPE=sqlite
SQLITE_DATABASE=./agent_backend.db

# Databricks Configuration (for LLM access)
DATABRICKS_CLI_PROFILE=db-ml-models-prod-us-west
DATABRICKS_SERVING_ENDPOINT=databricks-gpt-5-2

# App Configuration  
WORKSPACE_ID=388866748606889

# Note: PostgreSQL variables are not needed for local SQLite development
# PGHOST=
# PGPORT=5432
# PGDATABASE=databricks_postgres
# PGUSER=
